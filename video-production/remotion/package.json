{
  "name": "wusheng-aic-video",
  "version": "1.0.0",
  "private": true,
  "description": "Editable local Wusheng AIC competition film production",
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "render": "remotion render src/index.ts WushengFilm ../output/wusheng-aic-2026.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remotion": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/bundler": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/captions": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "@remotion/player": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
